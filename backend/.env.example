# 配置示例。复制为 backend/.env 后再填写本机值；.env 不纳入源码交付。
# 本文件只声明骨架阶段需要的变量。OCR 厂商相关变量（API Key、endpoint、模型、区域）
# 由步骤 08 的适配器定义后再追加，步骤 00 不预设变量名。

# 运行环境标识：development / testing / production
APP_ENV=development

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 应用密钥。本机自行生成，示例中只允许占位值。
SECRET_KEY=change-me

# 数据库连接串。默认使用 backend/var 下的 SQLite 文件。
# 相对的 SQLite 路径按 backend/ 解析（不是按当前工作目录），因此 python app.py 与
# python -m alembic upgrade head 无论从哪个目录执行都指向同一个数据库文件。
DATABASE_URL=sqlite:///var/inventory.db

# 原始单据与上传文件的本地存储根目录。可用相对 backend/ 的路径或绝对路径。
# 目录在首次保存文件时自动创建。
FILE_STORAGE_DIR=var/uploads

# 单个上传文件的大小上限（字节）。默认 20 MB：手机拍的单据照片一般 2—6 MB，
# 多页 PDF 可能到十几 MB。一次请求的总上限是它的 4 倍（见 src/factory.py）。
UPLOAD_MAX_BYTES=20971520

# OCR 适配器选择。骨架阶段只有 fake 可用（明确标识的假数据，不冒充真实识别结果）；
# 真实厂商在步骤 07 评估、步骤 08 接入后才允许改为其它值。
OCR_PROVIDER=fake

# 本机监听地址与端口（python app.py 使用）。
# 当前阶段是本地演示，没有身份认证与访问控制，不要绑定到公网地址。
HOST=127.0.0.1
PORT=5000

# --- 步骤 08：真实 OCR 提取 ---

# 识别器选择：fake（明确标识的假数据）或 dashscope（阿里云 Model Studio）。
# ⚠️ 选了 dashscope 却没凭据会**启动失败**，不会静默退回假数据——后者会让人以为
# 真实识别已经接通。没有凭据时就留在 fake：手工录入与表格导入两条通路不需要它。
OCR_PROVIDER=fake

# API Key 与工作空间专属域名。
# **故意不给默认 endpoint**：老域名 dashscope.aliyuncs.com 自 2026-09-30 起不再
# 支持新功能，猜一个默认值的代价是"连上了但走的是将被弃用的那条路"，而且不报错。
# 域名取自百炼控制台「业务空间管理」页的 API Host 列，形如
# https://{WorkspaceId}.{region}.maas.aliyuncs.com/compatible-mode/v1
# 步骤 07 评测脚本用的 DASHSCOPE_API_KEY / DASHSCOPE_BASE_URL 也会被读取（作为
# 兼容别名），不必把同一个值抄两遍。
OCR_API_KEY=
OCR_BASE_URL=

# 并行跑哪几个模型，第一个是主模型。
# ⚠️ 这是步骤 07 用 74 张真实扫描件 + 4 张小票实测选出来的生产配置：
# qwen3.5-ocr（字段准确率 96.6%）+ qwen3-vl-plus（92.0%）作第二意见，一致才预填、
# 分歧必须人填。qwen-vl-ocr 已落选（48.9%，且会把空表格行格填满），
# vanchin/deepseek-ocr 需要先在控制台开通产品——两者配上去都会被直接拒绝。
# **改这份名单等于换一个被测配置**，那批准确率数字就不再适用，要重跑
# tools/eval_adapter.py。
OCR_MODELS=qwen3.5-ocr,qwen3-vl-plus

# 单次调用超时（秒）与重试次数。步骤 07 实测单页 5—7 秒、最慢 19.6 秒；
# 240 秒给多页与网络抖动留足余量。重试只对限流与服务端故障生效，
# 凭据无效之类不重试——再试一百次也一样。
OCR_TIMEOUT_SECONDS=240
OCR_MAX_ATTEMPTS=3

# 提取怎么跑：thread（应用内后台线程，提取**不挂在 HTTP 请求里**）或
# inline（在当前请求里跑完，测试与脚本用）。
# 手写件约 15 秒，挂在请求里会让老板对着转圈等，浏览器一关这次提取就白花了钱。
# ⚠️ 两种方式跑的是同一份提取代码，只差一个调度器；任务一样落库，
# GET /api/invoices/<id>/extraction 在两种方式下都查得到状态。
OCR_WORKER_MODE=thread
OCR_WORKER_THREADS=2
